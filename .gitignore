# ROS 2 빌드 산출물
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
extrame-robot/

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 요구사항/문서 (계속 바뀌고 버전관리 불필요)
docs/

# FSM 원본 (용량 커서 커밋 제외, 로컬/별도 공유)
*.drawio

# YOLO 모델 가중치 (용량 커서 커밋 제외, 각자 다운로드/공유 드라이브)
*.pt
*.engine
*.onnx

# 실행 로그/디버그 캡처 (세션 산출물 — 중요한 건 예외적으로 git add로 개별 커밋됨)
ros2_ws/*.log
ros2_ws/debug_capture.png

# 키보드 텔레옵 저장 자세 (teleop_core poses_file 기본 경로 — 벤치마다 다름, 런타임 산출물)
ros2_ws/dynamixel_arm_poses.json
# 리미트 측정 모드(calib_*)로 실측한 관절별 상/하한 (teleop_core joint_limits_file
# 기본 경로 — 벤치/서보마다 다른 실측값, 런타임 산출물)
ros2_ws/dynamixel_arm_joint_limits.json

# 분석 스크립트가 뱉는 중간 데이터 (stow_eval.py sweep 등 — 스크립트로 재생성 가능)
ros2_ws/*.npy

# camera_tf_tuner 의 save 서비스 산출물 (벤치/장착마다 다른 실측값 — 확정되면
# camera_tf.launch.py 기본값에 직접 반영한다)
ros2_ws/camera_tf_calib.txt
