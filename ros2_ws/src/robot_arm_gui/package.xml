<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_arm_gui</name>
  <version>0.1.0</version>
  <description>브라우저 관제 GUI — 서보 진단·FSM/계약 상태·YOLO 인식·텔레옵 현황 (읽기 전용)</description>
  <maintainer email="koreanmcpe@gmail.com">ksp118</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>robot_arm_msgs</depend>
  <!-- /perception/*_image → numpy 변환 (MJPEG 인코딩용) -->
  <depend>cv_bridge</depend>

  <!--
    계약 어휘(contract.py)와 QoS 프로파일(qos_profiles.py)의 단일 출처.
    GUI 가 status 문자열이나 QoS 를 자기 쪽에 복사해 두면 언젠가 실제 게이트와
    어긋나므로, 원본 모듈을 그대로 import 한다.
  -->
  <exec_depend>dynamixel_control</exec_depend>

  <!--
    ament_pep257 은 일부러 빼 뒀다. 기본 규칙이 D213(요약을 두 번째 줄에서 시작)을
    켜는데, 이 저장소의 docstring 은 전부 첫 줄에서 시작하는 관례라 통과할 수가 없다
    (dynamixel_control 97건 / robot_arm_perception 32건이 이미 위반 중이다).
    이 패키지만 관례를 바꾸면 오히려 읽기 나빠지므로, 통과하지 못할 걸 아는 테스트를
    새로 들이는 대신 flake8 만 건다.
  -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
