    <disable_collisions link1="link_043" link2="link_046" reason="Adjacent"/>
    <disable_collisions link1="link_043" link2="link_047" reason="Adjacent"/>
    <disable_collisions link1="link_035" link2="wrist_camera_link" reason="Adjacent"/>

    <!-- 2026-07-31 재산출: /check_state_validity 서비스로 관절 리밋 안쪽 무작위 200샘플
         (arm_joint_1~5 + gripper_left_pinion_joint, seed=42) 실행 — 이전 SRDF의 40~3000샘플과
         같은 방법론(scripts/sample_collision_matrix.py 계승, 스크립트는 세션 스크래치에만 있고
         커밋 대상 아님). 아래는 200/200(100%) 즉 자세와 무관하게 항상 충돌한 쌍만 Default로
         등록 — 이전 관례와 동일하게 99% 이하는(예: link_012/013 99%, link_036/038 92%,
         link_011/015 90%, link_016/017 88%) "자세에 따라 변하는 진짜 self-collision"으로 보고
         disable 하지 않음(교체 전 SRDF의 2839/3000=94.6% 케이스를 disable 금지로 판단한 것과
         같은 기준). 홈 자세 최초 재현 시 잡았던 link_047/link_051·link_046/link_050 추정은
         샘플링 결과 실제로는 link_047/link_050·link_043/link_051·link_046/link_051 조합이었음
         (심볼릭 좌우대칭 추정이 아니라 실측으로 교체). -->
    <disable_collisions link1="link_047" link2="link_050" reason="Default"/>
    <disable_collisions link1="link_043" link2="link_051" reason="Default"/>
    <disable_collisions link1="link_016" link2="link_021" reason="Default"/>
    <disable_collisions link1="link_034" link2="link_038" reason="Default"/>
    <disable_collisions link1="link_035" link2="link_037" reason="Default"/>
    <disable_collisions link1="link_007" link2="link_017" reason="Default"/>
    <disable_collisions link1="link_025" link2="link_027" reason="Default"/>
    <disable_collisions link1="link_006" link2="link_009" reason="Default"/>
    <disable_collisions link1="link_001" link2="link_004" reason="Default"/>
    <disable_collisions link1="link_003" link2="link_004" reason="Default"/>
    <disable_collisions link1="link_043" link2="link_049" reason="Default"/>
    <disable_collisions link1="link_043" link2="link_048" reason="Default"/>
    <disable_collisions link1="link_035" link2="link_036" reason="Default"/>
    <disable_collisions link1="link_021" link2="link_023" reason="Default"/>
    <disable_collisions link1="link_014" link2="link_027" reason="Default"/>
    <disable_collisions link1="link_006" link2="link_010" reason="Default"/>
    <disable_collisions link1="link_015" link2="link_016" reason="Default"/>
    <disable_collisions link1="link_032" link2="link_034" reason="Default"/>
    <disable_collisions link1="link_046" link2="link_051" reason="Default"/>
    <disable_collisions link1="link_007" link2="link_019" reason="Default"/>

    <!-- 2026-07-31 추가: 위 200샘플(연속 관절 무작위)이 gripper_left_pinion_joint=0(완전 닫힘,
         SRDF home/stow group_state 값)이라는 경계값을 확률상 거의 뽑지 못해 놓친 쌍. 그리퍼
         완전 닫힘 + 팔 무작위 30샘플로 별도 재검증: 팔 자세와 무관하게 30/30 항상 충돌 —
         랙-피니언이 완전히 맞물리는 경계 상태의 기하 아티팩트로 판단, disable 안전함.
         **home/stow(all-zero) 자세가 실제로 이 두 쌍 없이는 collision-valid하지 않았던 상태라
         중요** — STOWED_LOCKED 계약과 직결되므로 반드시 포함할 것. -->
    <disable_collisions link1="link_046" link2="link_050" reason="Default"/>
    <disable_collisions link1="link_047" link2="link_051" reason="Default"/>

    <!-- ⚠️ TODO: 200샘플도 Setup Assistant 기본값(수천)보다는 적어 근거가 여전히 약함 —
         디스플레이 있는 환경에서 기회 되면 GUI "Regenerate Default Collision Matrix"로 이 블록을
         정식 결과로 덮어쓸 것. 특히 71~99% 구간 쌍들(link_012/013, link_036/038, link_011/015,
         link_016/017, link_015/017, link_036/037)은 실기 조립 시 실제로 닿는지 별도 확인 권장. -->

    <!-- 2026-08-09 추가: 강체 클러스터 기준 Adjacent 보정 (scripts/fix_adjacent_collisions.py).
         CAD 자동 export 라 하나의 물리 강체가 fixed 로 이어진 link_0XX 여러 개로
         쪼개져 있는데, Setup Assistant 의 Adjacent 판정은 URDF 직계 parent/child 만
         봐서 (a) 같은 강체 안의 형제 링크, (b) 가동 조인트 하나를 사이에 둔 강체 쌍이
         통째로 빠졌다. 그 결과 home(전 관절 0) 자세조차 6쌍이 충돌로 떠 MoveIt 이
         모든 계획을 거부했다. 가동 조인트 2개 이상 떨어진 쌍(진짜 self-collision)은
         건드리지 않았다. -->
    <disable_collisions link1="base_link" link2="link_003" reason="same-cluster" />
    <disable_collisions link1="base_link" link2="link_004" reason="adjacent-cluster" />
    <disable_collisions link1="base_link" link2="link_005" reason="adjacent-cluster" />
    <disable_collisions link1="base_link" link2="link_006" reason="adjacent-cluster" />
