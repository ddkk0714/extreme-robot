    <disable_collisions link1="link_017" link2="link_019" reason="Adjacent"/>
    <disable_collisions link1="link_014" link2="link_018" reason="Adjacent"/>
    <disable_collisions link1="link_018" link2="link_020" reason="Adjacent"/>
    <disable_collisions link1="link_020" link2="link_021" reason="Adjacent"/>
    <disable_collisions link1="link_021" link2="link_022" reason="Adjacent"/>
    <disable_collisions link1="link_022" link2="link_023" reason="Adjacent"/>
    <disable_collisions link1="link_023" link2="link_024" reason="Adjacent"/>
    <disable_collisions link1="link_023" link2="link_025" reason="Adjacent"/>
    <disable_collisions link1="link_023" link2="link_026" reason="Adjacent"/>
    <disable_collisions link1="link_026" link2="link_028" reason="Adjacent"/>
    <disable_collisions link1="link_028" link2="link_030" reason="Adjacent"/>
    <disable_collisions link1="link_030" link2="link_032" reason="Adjacent"/>
    <disable_collisions link1="link_030" link2="link_033" reason="Adjacent"/>
