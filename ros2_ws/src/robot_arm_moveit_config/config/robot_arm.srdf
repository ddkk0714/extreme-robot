<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="robot_arm">
    <!-- 2026-07-31: 2026_07_29_랙피니언_URDF_description.zip(base_link~5축 팔~그리퍼~손목카메라
         통합 CAD export) 전체로 robot_arm.urdf를 재생성하면서 이 SRDF도 같이 갱신함. 링크 번호가
         전부 새로 매겨졌으므로(link_0XX BFS 순서 재부여) 이전 SRDF의 링크 번호는 전부 무효.
         조인트 시맨틱 이름(arm_joint_1..5, gripper_left_pinion_joint 등)은 그대로 유지돼 바뀌지
         않음 — group/group_state 정의는 그래서 그대로 둠.
         arm 체인 tip_link는 이제 link_043(그리퍼 하우징, 구 "본체22_1") — 이전 SRDF는 link_039
         ("5축 모듈 연결부")를 썼는데, 그건 예전 그리퍼 이식이 중간 고정 링크 2개(5축 모듈 연결부
         -> 본체40_1 -> 본체22_1)를 생략한 축약판이었기 때문. 이번 전체 재생성은 zip 원본 체인을
         그대로 보존해 더 길어졌고, 실제 그리퍼가 물리적으로 붙는 link_043을 tip_link/end_effector
         parent_link로 잡는 게 더 정확함. arm_fsm_node.py의 tip_link 기본값도 이 커밋에서 같이
         'link_043'으로 갱신함(반드시 동기화 유지). -->
    <group name="arm">
        <chain base_link="base_link" tip_link="link_043"/>
    </group>
    <group name="gripper">
        <joint name="gripper_left_pinion_joint"/>
    </group>
    <group_state name="home" group="arm">
        <joint name="arm_joint_1" value="0"/>
        <joint name="arm_joint_2" value="0"/>
        <joint name="arm_joint_3" value="0"/>
        <joint name="arm_joint_4" value="0"/>
        <joint name="arm_joint_5" value="0"/>
    </group_state>
    <!-- 주행 중 접힘 자세. 팀이 주행 안정성(CG 160mm — 도달 가능한 자세 중 최저) 기준으로
         all-zero 를 선택했다(2026-07-29). 즉 위 home 과 값이 같다 — 의도된 중복이고,
         "여기가 stow 다"를 명시하려고 따로 둔다.
         점유 bbox 224×606mm / 높이 285mm / 중력토크 13.13N·m / 자기충돌 0.
         ⚠️ 파워트레인 문서 §6 은 all-zero home 을 production 에서 금지한다 — 양 팀 합의 전까지
         실차 연동 금지. 근거·회피책은 arm_fsm_node.py 의 stow_joint_positions 주석 참고. -->
    <group_state name="stow" group="arm">
        <joint name="arm_joint_1" value="0"/>
        <joint name="arm_joint_2" value="0"/>
        <joint name="arm_joint_3" value="0"/>
        <joint name="arm_joint_4" value="0"/>
        <joint name="arm_joint_5" value="0"/>
    </group_state>
    <!-- URDF 리미트 기준: 0 = 완전 닫힘, 1.9444 = 완전 열림.
         실제 파지 폭은 서보 tick 캘리브레이션(gripper_presets.py) 후 재조정 필요. -->
    <group_state name="gripper_open" group="gripper">
        <joint name="gripper_left_pinion_joint" value="1.9444444444444444"/>
    </group_state>
    <group_state name="gripper_closed" group="gripper">
        <joint name="gripper_left_pinion_joint" value="0"/>
    </group_state>
    <end_effector name="gripper_a" parent_link="link_043" group="gripper" parent_group="arm"/>
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <!-- 아래 disable_collisions는 현재 URDF(52 link / 51 joint, 2026-07-31 전체 재생성)의 모든
         joint(fixed 포함)로부터 자동 도출한 "Adjacent"(부모-자식) 쌍만 포함 — 프로그램적으로
         100% 기계적 도출, 값 조작 없음. -->
    <disable_collisions link1="base_link" link2="link_001" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link_002" reason="Adjacent"/>
    <disable_collisions link1="link_002" link2="link_003" reason="Adjacent"/>
    <disable_collisions link1="link_002" link2="link_004" reason="Adjacent"/>
    <disable_collisions link1="link_004" link2="link_005" reason="Adjacent"/>
    <disable_collisions link1="link_004" link2="link_006" reason="Adjacent"/>
