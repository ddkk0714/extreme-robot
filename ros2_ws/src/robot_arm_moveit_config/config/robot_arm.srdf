    <disable_collisions link1="link_024" link2="link_027" reason="Adjacent"/>
    <disable_collisions link1="link_027" link2="link_029" reason="Adjacent"/>
    <disable_collisions link1="link_029" link2="link_031" reason="Adjacent"/>
    <disable_collisions link1="link_031" link2="link_034" reason="Adjacent"/>
    <disable_collisions link1="link_035" link2="link_038" reason="Adjacent"/>
    <disable_collisions link1="link_033" link2="link_037" reason="Adjacent"/>
    <disable_collisions link1="link_037" link2="link_040" reason="Adjacent"/>
    <disable_collisions link1="link_040" link2="link_041" reason="Adjacent"/>
    <disable_collisions link1="link_041" link2="link_042" reason="Adjacent"/>
    <disable_collisions link1="link_042" link2="link_043" reason="Adjacent"/>
    <disable_collisions link1="link_043" link2="link_044" reason="Adjacent"/>
    <disable_collisions link1="link_043" link2="link_045" reason="Adjacent"/>
    <disable_collisions link1="link_044" link2="link_048" reason="Adjacent"/>
